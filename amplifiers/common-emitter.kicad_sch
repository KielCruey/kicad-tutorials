	(text "voltage\ndivider\nbiasing"
		(exclude_from_sim no)
		(at 210.058 51.562 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "35f81606-5979-4c17-91e2-6606d393f536")
	)
	(text "Equations:\nc2 >= 1 / (2 * pi * f * r_in), r_in = R1||R2||(β*Re)\nc3 >= 1 / (2 * pi * f * (r_collector + r_load))\nc_by-pass = 1 / (2 * pi * f * Xc), Xc = 22 (1/10 of R_emitter), f = 60hz\n\nvoltage-gain_low-hz = - R_load / (R_emitter + R_transitor's-emitter-resistance)\nvoltage-gain_high-hz = - R_load / R_transitor's-emitter-resistance"
		(exclude_from_sim no)
		(at 27.432 133.604 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "36f94c99-fe28-41c8-a03a-627078944320")
	)
	(text "Equations (NPN):\nI_base + I_collector = I_emitter\nβ = I_collector / I_base\n"
		(exclude_from_sim no)
		(at 99.06 54.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "421ef9c1-e696-4115-b34c-b922334f4b24")
	)
