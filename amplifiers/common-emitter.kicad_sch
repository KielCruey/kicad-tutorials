				(size 1.27 1.27)
			)
		)
		(uuid "7421893b-3047-409b-a033-8c21109f7cf4")
	)
	(text "common emitter amplifier (inverting amp)\n* input signal source and output load share the same emitter lead of the transistor\n* biasing allows the transitor to prepare to receive a signal and to reduce distortion\n* quiescent operating point or q-point allows us to see all the possible operating points of the transistor from fully \"ON\" to fully \"OFF\"\n* beta value (hFE) is current gain"
		(exclude_from_sim no)
		(at 95.758 127.508 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fe71d089-e37e-4766-b716-da0e91536753")
	)
