	(text "assumptions:\nb (beta) = 100\nf = 20hz"
		(exclude_from_sim no)
		(at 96.012 54.61 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "27daeff9-de23-49e2-a76a-9c2452da52c3")
	)
	(text "Equations:\nc2 >= 1 / (2 * pi * f * r_in), r_in = R1||R2||(β*Re)\nc3 >= 1 / (2 * pi * f * (r_collector + r_load))\nc_by-pass = 1 / (2 * pi * f * Xc), Xc = 22 (1/10 of R_emitter), f = 60hz\n\nvoltage-gain_low-hz = - R_load / (R_emitter + R_transitor's-emitter-resistance)\nvoltage-gain_high-hz = - R_load / R_transitor's-emitter-resistance"
		(exclude_from_sim no)
		(at 96.012 141.224 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "36f94c99-fe28-41c8-a03a-627078944320")
	)
	(text "common emitter amplifier (inverting amp)"
		(exclude_from_sim no)
		(at 55.626 22.606 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "668331df-6b38-4795-b3aa-5b9357937e05")
	)
	(text "voltage\ndivider\nbiasing"
