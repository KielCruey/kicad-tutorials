	(text "Equations (PNP):\nI_emitter = I_base + I_collector\nβ = I_collector / I_base\nI_collector = β I_base"
		(exclude_from_sim no)
		(at 256.032 51.562 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
