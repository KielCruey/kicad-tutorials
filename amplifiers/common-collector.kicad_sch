	)
	(text "common collector amplifier (emitter/voltage follower)\n* used when a high impedance input source needs to be connected to a low impedance load requiring a high current gain\n* output voltage tends to be unity gain and phase is in-phase\n* makes a good buffer curcuit because of near unity gain\n* can be used as an impedence matching curcuit\n* can be a good current amplifier with small changes in Ib significantly effects Icb"
		(exclude_from_sim no)
		(at 90.17 131.826 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7ecff648-04d6-4bf6-b7d9-a4b983a46613")
	)
